* text=auto
*.json text eol=lf
*.java text eol=lf
*.py text eol=lf
*.md text eol=lf
*.tsv text eol=lf
*.sh text eol=lf
*.gz binary
mvnw text eol=lf
mvnw.cmd text eol=crlf

*.cs text eol=lf
*.csproj text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
data/generated/** text eol=lf
data/generated/**/*.gz binary

# Empty final TSV cells are significant; preserve their delimiters.
data/generated/**/*.tsv whitespace=-blank-at-eol
data/generated/*.tsv whitespace=-blank-at-eol
